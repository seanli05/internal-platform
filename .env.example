# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
# Every variable the app reads is documented here. Values below are dummies.

# --- Application ---------------------------------------------------------------

# Human-readable app name, surfaced in the OpenAPI docs.
APP_NAME=DSS Internal

# One of: local | ci | staging | production.
ENVIRONMENT=local

# Enables developer-only affordances (e.g. the future "act as user" impersonation
# header). MUST be false in staging and production.
DEV_MODE=true

# Python logging level for the API and the worker: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------------

# SQLAlchemy URL used by the API, the worker, and Alembic.
# This value is for running things on the host (pytest, `alembic upgrade head`);
# inside Docker Compose the host is `postgres`, and compose sets it for you.
DATABASE_URL=postgresql+psycopg://dss:dss_local_password@localhost:5432/dss  # pragma: allowlist secret

# Credentials the Compose `postgres` service is created with. Keep them in sync
# with DATABASE_URL above.
POSTGRES_USER=dss
POSTGRES_PASSWORD=dss_local_password
POSTGRES_DB=dss

# Host port the Compose `postgres` service is published on.
POSTGRES_PORT=5432

# --- Ports ---------------------------------------------------------------------

# Host port the Compose `api` service is published on.
API_PORT=8000

# --- Worker --------------------------------------------------------------------

# Seconds the worker sleeps between polls. (Phase 0: between liveness log lines.)
WORKER_POLL_INTERVAL_SECONDS=5
